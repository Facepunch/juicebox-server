{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Juicebox": "Data Source=App_Data/juicebox.db"
  },
  "Juicebox": {
    "JoinCodeLength": 6,
    "SessionTimeout": "00:05:00",
    "MemberTimeout": "00:05:00",
    "RetainDestroyedFor": "7.00:00:00",
    "SocketTicketLifetime": "00:01:00",
    "MaxMessageBytes": 1048576,
    "PublicUrl": "",
    "CorsOrigins": [],
    "TrustedProxies": [],
    "JoinRateLimitPerMinute": 30,
    "CreateRateLimitPerMinute": 10
  }
}
